@startuml Trabajo Practico Programacion 2 Grupo 02 

title Gestion de pedidos en un restaurante 

class Restaurante {
    - historialPedidos:Pedido[]
    - menu: Menu[]
    - estaciones EstacionDeTrabajo[]

    + registrarPedido():void
    + agregarItem(p:Pedido, i:ItemPedido):void
    + quitarItem(p:Pedido):void
    + confirmarPedido(p:Pedido):void
    + facturarPedido():number
    + agregarItemMenu(item: Menu):void
    + eliminarItemMenu(item: Menu):void
    + consultarRecaudacion():void
}
'--------------------------------------------------------
interface Comando {
    + ejecutar(comando: Comando)
    + deshacer()
}
abstract class Pedido {
    - items: Stack<ItemPedido>
    - estado: EstadoPedido
    - historial: Stack<Comando>
    
    - validarEnConstruccion(): void
    + agregarItem(item: ItemPedido): void
    + quitarUltimoItem(): void
    + confirmar(): void
    + puedeFacturarse(): boolean
    + calcularSubtotal(): number
    + abstract calcularCostoAdicional():number

    + deshacer(): void
    # ejecutar(comando: Comando): void
}

enum EstadoPedido{
    EN_CONSTRUCCION,
    CONFIRMADO,
    FINALIZADO
}

class PedidoEnSalon {
    - mesa:string
    

}

class PedidoParaRetirar {
    - horario:number

}

class PedidoDelivery {
    - direccion:string
    - costoEnvio:number

}

class ItemPedido {
    - item: Menu
    - cantidad: number
    - estado: EstadoItem

    + getPrecio(): number
    + estaListo(): boolean
    + puedeModificarse(): boolean
    + modificar(): void
}

class ItemPreparacion {
    - producto: Producto
    - cantidad : number
    - estado: EstadoItem

    + comenzarPreparacion(): void
    + marcarListo(): void
}

enum EstadoItem {
    PENDIENTE,
    EN_PREPARACION,
    LISTO
}
'----------------------------------------------------------
abstract class Menu {
    - nombre: string
    - precio: number

    {abstract} getPrecio(): number
    + getNombre(): string
}

class Producto {
    - categoria: Categoria
    - tipoEstacion: TipoEstacionTrabajo

    + getPrecio()
}

class Combo {
    - productos[]:Menu
    - TipoDeDescuento

    + getPrecio()
}

enum Categoria {
    ENTRADA,
    PLATO_PRINCIPAL,
    BEBIDA,
    POSTRE
}

interface TipoDeDescuento {
    + calcular(productos: Menu[]): number;
}
class descuentoPorcentual implements TipoDeDescuento{}
class PrecioFijo implements TipoDeDescuento{}
'----------------------------------------------------------
class EstacionDeTrabajo{
    - colaDePedidos: Queue<ItemPedido>;
    - enum TipoEstacionTrabajo

    + recibirItem(item: ItemPedido): void
    + prepararSiguiente(item: ItemPedido): void
}
enum TipoEstacionTrabajo{
    PARRILLA,
    COCINAFRIA,
    BARRA,
    COCINADULCE
}
'----------------------------------------------------------
class Factura {
    - totalPedido: number
    - descuentos: Descuento[] // puede acumular dto en efectivo + dto especial
    - totalCobrado: number

    + calcularTotal(): number
}

enum MedioDePago {
    EFECTIVO,
    TARJETA_DEBITO,
    TARJETA_CREDITO,
    BILLETERA_VIRTUAL
}
interface Descuento {
    + getNombre(): string
    + aplica(medioPago: MedioDePago, fecha:Date): boolean
    + calcular(subtotal: number): number
}
class DescuentoEfectivo {
    - porcentaje: number
}
class DescuentoDiaEspecial {
    - diaSemana: number
    - porcentaje: number
}
class SinDescuento

class SelectorDeDescuento {
    - descuentos: Descuento[]
    + elegirMejor(subtotal: number, medioPago: MedioDePago, fecha: Date): Descuento
}

Pedido <|-u- PedidoEnSalon
Pedido <|-u- PedidoDelivery
Pedido <|-u- PedidoParaRetirar
Pedido *-l- ItemPedido
Pedido .r.> Factura 
Pedido --> EstadoPedido
Pedido ..> SelectorDeDescuento
Factura <.. Descuento

ItemPedido *-- ItemPreparacion
ItemPreparacion --> EstadoItem

Combo ..|> TipoDeDescuento
Combo -u-|> Menu
Producto -u-|> Menu
Producto --> Categoria

Descuento <|.. DescuentoEfectivo
Descuento <|.. DescuentoDiaEspecial
Descuento <|.. SinDescuento

EstacionDeTrabajo -u-> TipoEstacionTrabajo

Restaurante *-- Menu
Restaurante *-r- EstacionDeTrabajo
Restaurante *-- Pedido
Restaurante o-l- MedioDePago

@enduml
